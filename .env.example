# Data layer: hosted Supabase project OR self-hosted Supabase / PostgREST + GoTrue
# (src/integrations/supabase/client.ts reads these at build time)
VITE_SUPABASE_URL="https://your-supabase-or-postgrest-host"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="self-hosted"

# Custom Node.js/Express backend replacing the edge functions
# Endpoints: POST /api/telegram-bot, /api/manage-bot, /api/auto-scan
#            POST or GET /api/get-channel-file?file_id=..&message_id=..
# Leave unset to use the same origin under /api (nginx reverse proxy).
VITE_API_BASE_URL="/api"
